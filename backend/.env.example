# SmritiCare Backend Environment Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_change_in_production

# Database Configuration (MySQL / MariaDB / Aiven Cloud)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=your_password
DATABASE_NAME=smriticare
DATABASE_SSL=false
DATABASE_URL="mysql://root:password@localhost:3306/smriticare"

# AWS Private Media Storage (S3)
AWS_REGION=ap-south-1
S3_BUCKET_NAME=smriticcare-private-files-kashif-2026-2

# Automated Email Notifications (SMTP Provider / Test Mode)
# Leave EMAIL_SIMULATION_MODE=true for testing without real credentials
EMAIL_SIMULATION_MODE=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
FROM_EMAIL=notifications@smriticare.org
